/**
 * MemeCoinAI - Secure Monitization & Subscription Backend
 * Run with: node server.js
 */
const express = require('express');
const cors = require('cors');
const Stripe = require('stripe');

const app = express();
// Verwende Umgebungsvariablen für deine echten Keys!
const stripe = Stripe(process.env.STRIPE_SECRET_KEY || 'sk_test_placeholder');

app.use(cors());

// Webhook Raw Parser für Stripe Signatur-Prüfung
app.post('/api/v1/webhook/stripe', express.raw({ type: 'application/json' }), (req, res) => {
    const sig = req.headers['stripe-signature'];
    let event;

    try {
        event = stripe.webhooks.constructEvent(req.body, sig, process.env.STRIPE_WEBHOOK_SECRET || 'whsec_placeholder');
    } catch (err) {
        console.error(`[WEBHOOK FEHLER] ${err.message}`);
        return res.status(400).send(`Webhook Error: ${err.message}`);
    }

    // Behandlung erfolgreicher Zahlungen
    if (event.type === 'checkout.session.completed') {
        const session = event.data.object;
        const walletAddress = session.metadata.solanaWallet;

        // In Datenbank speichern: Wallet hat jetzt Premium Status für 30 Tage
        activatePremiumForWallet(walletAddress, 30);
        console.log(`[PREMIUM AKTIVIERT] Wallet: ${walletAddress}`);
    }

    res.json({ received: true });
});

app.use(express.json());

// In-Memory Datenbank (Für Produktion: PostgreSQL oder Supabase nutzen)
const db = new Map(); // walletAddress -> { isPremium: boolean, expiresAt: Date }

function activatePremiumForWallet(wallet, days = 30) {
    const expiresAt = new Date();
    expiresAt.setDate(expiresAt.getDate() + days);
    db.set(wallet, { isPremium: true, expiresAt });
}

// 1. API: Serverseitige Aboprüfung (Plattformgebühr festlegen)
app.get('/api/v1/subscription/:wallet', (req, res) => {
    const { wallet } = req.params;
    const sub = db.get(wallet);

    if (sub && sub.isPremium && new Date() < new Date(sub.expiresAt)) {
        return res.json({ 
            premium: true, 
            feeBps: 0, // 0 Basis-Punkte (0.0% Fee)
            message: "Premium Aktiv - Keine Plattformgebühr" 
        });
    }

    // Standard Free Tier: 0,5% Gebühr (50 Bps = Basis-Punkte)
    return res.json({ 
        premium: false, 
        feeBps: 50, // 50 Basis-Punkte (0.5% Fee)
        message: "Free Tier - 0.5% Plattformgebühr" 
    });
});

// 2. API: Stripe Checkout Session erstellen
app.post('/api/v1/create-checkout-session', async (req, res) => {
    const { walletAddress } = req.body;

    if (!walletAddress) {
        return res.status(400).json({ error: "Wallet-Adresse erforderlich" });
    }

    try {
        const session = await stripe.checkout.sessions.create({
            payment_method_types: ['card'],
            line_items: [{
                price_data: {
                    currency: 'eur',
                    product_data: {
                        name: 'MemeCoinAI Premium Mitgliedschaft',
                        description: '0% Plattformgebühren beim Swappen + Pro Sniper Signale',
                    },
                    unit_amount: 1999, // 19.99 EUR in Cents
                    recurring: { interval: 'month' },
                },
                quantity: 1,
            }],
            mode: 'subscription',
            metadata: { solanaWallet: walletAddress },
            success_url: `https://memecoinai1.github.io/MemeCoinAI-/?payment=success`,
            cancel_url: `https://memecoinai1.github.io/MemeCoinAI-/?payment=cancelled`,
        });

        res.json({ url: session.url });
    } catch (e) {
        res.status(500).json({ error: e.message });
    }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`[MemeCoinAI Backend] Läuft auf Port ${PORT}`);
});
